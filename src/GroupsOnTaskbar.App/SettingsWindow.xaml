<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GroupsOnTaskbar_App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:GroupsOnTaskbar.App.ViewModels"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="Settings issue"
            AutomationProperties.AutomationId="SettingsErrorInfoBar"
            AutomationProperties.Name="Settings validation message"
            CloseButtonClick="OnErrorInfoBarCloseButtonClick" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid MinWidth="920" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Groups" />

                        <ListView
                            x:Name="GroupsListView"
                            Height="280"
                            AutomationProperties.AutomationId="GroupsListView"
                            AutomationProperties.Name="Launcher groups"
                            ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:SettingsGroupItemViewModel">
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="WrapWholeWords" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Group name" />

                        <TextBox
                            x:Name="GroupNameTextBox"
                            AutomationProperties.AutomationId="GroupNameTextBox"
                            AutomationProperties.Name="Group name"
                            Text="{x:Bind ViewModel.GroupNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="AddGroupButton"
                                AutomationProperties.Name="Add group"
                                Click="OnAddGroupButtonClick"
                                Content="Add group" />

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="RenameGroupButton"
                                AutomationProperties.Name="Apply group name"
                                Click="OnRenameGroupButtonClick"
                                Content="Apply name"
                                IsEnabled="{x:Bind ViewModel.CanApplyGroupName, Mode=OneWay}" />

                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="DeleteGroupButton"
                                AutomationProperties.Name="Delete selected group"
                                Click="OnDeleteGroupButtonClick"
                                Content="Delete group"
                                IsEnabled="{x:Bind ViewModel.CanDeleteGroup, Mode=OneWay}" />

                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="MoveGroupUpButton"
                                AutomationProperties.Name="Move selected group up"
                                Click="OnMoveGroupUpButtonClick"
                                Content="Move up"
                                IsEnabled="{x:Bind ViewModel.CanMoveGroupUp, Mode=OneWay}" />
                        </Grid>

                        <Button
                            AutomationProperties.AutomationId="MoveGroupDownButton"
                            AutomationProperties.Name="Move selected group down"
                            Click="OnMoveGroupDownButtonClick"
                            Content="Move down"
                            IsEnabled="{x:Bind ViewModel.CanMoveGroupDown, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Shortcuts" />

                        <ListView
                            x:Name="ShortcutsListView"
                            Height="280"
                            AutomationProperties.AutomationId="ShortcutsListView"
                            AutomationProperties.Name="Group shortcuts"
                            ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedShortcut, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:SettingsShortcutItemViewModel">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TargetPath}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Display name" />

                        <TextBox
                            x:Name="ShortcutDisplayNameTextBox"
                            AutomationProperties.AutomationId="ShortcutDisplayNameTextBox"
                            AutomationProperties.Name="Shortcut display name"
                            Text="{x:Bind ViewModel.ShortcutDisplayNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Target path" />

                        <TextBlock
                            AutomationProperties.AutomationId="SelectedShortcutTargetPath"
                            AutomationProperties.Name="Selected shortcut target path"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SelectedShortcutTargetPath, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="AddShortcutButton"
                                AutomationProperties.Name="Add app to selected group"
                                Click="OnAddShortcutButtonClick"
                                Content="Add app"
                                IsEnabled="{x:Bind ViewModel.CanAddShortcut, Mode=OneWay}" />

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="RenameShortcutButton"
                                AutomationProperties.Name="Apply shortcut display name"
                                Click="OnRenameShortcutButtonClick"
                                Content="Apply name"
                                IsEnabled="{x:Bind ViewModel.CanApplyShortcutName, Mode=OneWay}" />

                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="DeleteShortcutButton"
                                AutomationProperties.Name="Remove selected app"
                                Click="OnDeleteShortcutButtonClick"
                                Content="Remove"
                                IsEnabled="{x:Bind ViewModel.CanDeleteShortcut, Mode=OneWay}" />

                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="MoveShortcutUpButton"
                                AutomationProperties.Name="Move selected app up"
                                Click="OnMoveShortcutUpButtonClick"
                                Content="Move up"
                                IsEnabled="{x:Bind ViewModel.CanMoveShortcutUp, Mode=OneWay}" />

                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="MoveShortcutDownButton"
                                AutomationProperties.Name="Move selected app down"
                                Click="OnMoveShortcutDownButtonClick"
                                Content="Move down"
                                IsEnabled="{x:Bind ViewModel.CanMoveShortcutDown, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                AutomationProperties.AutomationId="SaveSettingsButton"
                AutomationProperties.Name="Save settings"
                Click="OnSaveButtonClick"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                AutomationProperties.AutomationId="CancelSettingsButton"
                AutomationProperties.Name="Cancel settings changes"
                Click="OnCancelButtonClick"
                Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
