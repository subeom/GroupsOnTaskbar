<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GroupsOnTaskbar_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GroupsOnTaskbar_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ContentControl
        x:Name="RootHostControl"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        AutomationProperties.AutomationId="LauncherRootHost"
        IsTabStop="True">
        <ContentControl.KeyboardAccelerators>
            <KeyboardAccelerator
                x:Name="EscapeKeyboardAcceleratorControl"
                Key="Escape" />
        </ContentControl.KeyboardAccelerators>

        <local:MainPage />
    </ContentControl>
</Window>
