<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GroupsOnTaskbar_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GroupsOnTaskbar_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:GroupsOnTaskbar.App.ViewModels"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <ContentControl
        x:Name="RootHostControl"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        AutomationProperties.AutomationId="LauncherRootHost"
        AutomationProperties.Name="Taskbar Groups launcher"
        IsTabStop="True">
        <ContentControl.KeyboardAccelerators>
            <KeyboardAccelerator
                x:Name="EscapeKeyboardAcceleratorControl"
                Key="Escape" />
        </ContentControl.KeyboardAccelerators>

        <Grid Padding="16">
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <InfoBar
                        x:Name="StatusInfoBar"
                        Grid.Row="0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational"
                        AutomationProperties.AutomationId="LauncherStatusInfoBar"
                        AutomationProperties.Name="Launcher status" />

                    <ListView
                        x:Name="GroupListView"
                        Grid.Row="1"
                        Margin="0,0,0,4"
                        AutomationProperties.AutomationId="GroupSelector"
                        AutomationProperties.Name="Application groups"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionChanged="OnGroupListViewSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="MinWidth" Value="112" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:GroupViewModel">
                                <Border
                                    Padding="12,8"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    AutomationProperties.HelpText="{x:Bind AccessibleHelpText}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}" />
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2">
                        <GridView
                            x:Name="ShortcutGridView"
                            Margin="-4"
                            AutomationProperties.AutomationId="ShortcutGrid"
                            AutomationProperties.Name="Applications in the selected group"
                            IsItemClickEnabled="True"
                            ItemClick="OnShortcutGridViewItemClick"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None"
                            Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.HasShortcuts), Mode=OneWay}">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ShortcutViewModel">
                                    <Border
                                        Width="132"
                                        Padding="12"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Opacity="{x:Bind TileOpacity, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                        AutomationProperties.HelpText="{x:Bind TargetPathHelpText}"
                                        ToolTipService.ToolTip="{x:Bind TargetPath}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                                            <Grid Width="48" Height="48">
                                                <Image
                                                    Width="48"
                                                    Height="48"
                                                    Source="{x:Bind Icon, Mode=OneWay}"
                                                    Stretch="Uniform" />
                                                <SymbolIcon
                                                    Width="48"
                                                    Height="48"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Symbol="OpenFile"
                                                    Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                MaxLines="2"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind DisplayName}"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Visibility="{x:Bind AvailabilityVisibility, Mode=OneWay}">
                                                <SymbolIcon
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Symbol="Important"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind AvailabilityText}"
                                                    TextAlignment="Center"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Border
                            Padding="24"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.HasNoShortcuts), Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="OpenFile" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="No apps in this group"
                                    TextAlignment="Center" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxWidth="260"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="Open Settings to add apps to this group."
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="SettingsButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="SettingsButton"
                            AutomationProperties.Name="Open settings"
                            ToolTipService.ToolTip="Open settings"
                            Click="OnSettingsButtonClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Setting" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ExitButton"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="ExitButton"
                            AutomationProperties.Name="Exit launcher"
                            ToolTipService.ToolTip="Exit launcher"
                            Click="OnExitButtonClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Cancel" />
                                <TextBlock Text="Exit" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ContentControl>
</Window>
